# ==============================================================================
# Schutz IGNITION (Frontend) — .gitignore
# ==============================================================================

# Dependencies & Build Output
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite, Vitest & Playwright Cache
.vite/
.vitest/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local Environment Variables & Secrets
*.local
.env.local
.env.*.local
!*.env.example

# IDEs & System Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
